{
  "name": "CertMgmt Driver Dev",
  "image": "mcr.microsoft.com/devcontainers/python:3",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": {
    "system-packages": "sudo apt-get update && sudo apt-get install -y --no-install-recommends jq curl openssl shellcheck ncat nmap certbot python3-certbot-dns-cloudflare httpie",
    "python-deps": "pip install --user -r ${containerWorkspaceFolder}/requirements.txt ruff",
    "claude-code": "npm install -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "timonwong.shellcheck",
        "humao.rest-client",
        "rangav.vscode-thunder-client",
        "zainchen.json",
        "redhat.vscode-yaml",
        "Anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "ruff.importStrategy": "fromEnvironment",
        "shellcheck.enable": true,
        "shellcheck.executablePath": "shellcheck"
      }
    }
  },
  "remoteUser": "vscode"
}